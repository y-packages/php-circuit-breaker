{
    "name": "yaknet/circuit-breaker",
    "description": "A robust and resilient Circuit Breaker implementation for PHP applications.",
    "keywords": ["circuit-breaker", "resilience", "fault-tolerance", "fail-fast", "yaknet"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/yaknet/circuit-breaker",
    "authors": [
        {
            "name": "YakNet",
            "email": "info@yak.net.tr",
            "homepage": "https://yak.net.tr"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "YakNet\\CircuitBreaker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YakNet\\CircuitBreaker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyze": "vendor/bin/phpstan analyze src --level 5"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
